# Copy to app/.env.local (this folder, next to package.json) and fill in. .env.local is git-ignored.
# All values are public (shipped to the browser). Never put a Pollar SECRET key (sec_...) here.

# Pollar publishable key (pub_testnet_...) from https://dashboard.pollar.xyz > Developers > API keys.
# Enables Google login + signing. Without it the app runs read-only.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Pacta contract (see ../deployments/testnet.json). The variable keeps its original name.
NEXT_PUBLIC_DESPENSA_CONTRACT_ID=CDDIJ4LNQ3OR2XR5MM36L552FXMBLXXNNJDWJUWA5M57E6LPRRKWG66X
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# USDC on the current deployment (what Pollar wallets hold). DUSD only for a -Token demo deployment.
NEXT_PUBLIC_TOKEN_SYMBOL=USDC
# Circle testnet USDC issuer (mainnet USDC uses a different issuer).
NEXT_PUBLIC_TOKEN_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Display-only boliviano rate.
NEXT_PUBLIC_BOB_PER_USD=12

# Where sellers ask for the identity check that unlocks advances (WhatsApp number with country code,
# and/or an email). The verifier checks documents outside the app and marks the account in /verify.
NEXT_PUBLIC_VERIFY_WHATSAPP=
NEXT_PUBLIC_VERIFY_EMAIL=
